[Unit]
Description=Bee Node dashboard (status screen)
Documentation=file:/home/saba/iot-node/docs/OPERATING.md

# Deliberately NOT tied to graphical-session.target. Raspberry Pi OS's labwc
# session never activates that target — it is left inactive even with the
# desktop fully up — so a unit wanting it silently never starts at boot.
# default.target is reached by the user manager that lingering starts, which
# does happen on every boot.
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/saba/iot-node

# A user service started at boot inherits none of the desktop's session
# variables, so the display has to be named explicitly. Tk draws through
# XWayland, hence DISPLAY; WAYLAND_DISPLAY is set too for anything that
# prefers it.
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0

ExecStart=/home/saba/iot-node/.venv/bin/iot-node-screen

# At boot this may well start before the desktop exists. The screen exits
# non-zero when it cannot open a display, and systemd simply tries again — so
# it appears by itself a few seconds after the desktop finishes loading,
# rather than needing anyone to log in and start it.
Restart=always
RestartSec=5
StartLimitIntervalSec=0

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bee-node-screen

[Install]
WantedBy=default.target
