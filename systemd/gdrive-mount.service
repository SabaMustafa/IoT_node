[Unit]
Description=Google Drive mounted at ~/GoogleDrive (rclone)
Documentation=file:/home/saba/iot-node/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStartPre=/bin/mkdir -p %h/GoogleDrive
# --drive-skip-gdocs hides Docs/Sheets/Slides, which have no real bytes to
# download and otherwise appear as broken zero-length files.
ExecStart=/usr/bin/rclone mount gdrive: %h/GoogleDrive \
    --config=%h/.config/rclone/rclone.conf \
    --vfs-cache-mode=full \
    --vfs-cache-max-size=2G \
    --vfs-cache-max-age=24h \
    --dir-cache-time=72h \
    --poll-interval=1m \
    --drive-skip-gdocs \
    --umask=002 \
    --log-level=INFO
# Lazy unmount so a busy file manager cannot wedge shutdown.
ExecStop=/bin/fusermount3 -uz %h/GoogleDrive
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
