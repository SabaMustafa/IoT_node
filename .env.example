# Copy to .env and fill in. .env is gitignored and is read by both the CLI and
# the systemd unit. Values here are referenced from config.yaml as ${NAME}.

# Azure app registration (Entra ID > App registrations > your app > Overview)
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Only needed when cloud.onedrive.auth_mode is client_credentials.
GRAPH_CLIENT_SECRET=

# Queen Bee Watch Flask server on the Windows PC (see docs/FLASK-API.md).
# Leave FLASK_URL blank to turn forwarding off.
FLASK_URL=
# Same value as DEFAULT_HIVE_API_KEY in the server's .env.
FLASK_API_KEY=
